# First start only: creates the first admin account (password at least 8 characters).
# Ignored once an account exists; you can remove both afterwards.
ADMIN_USERNAME=me
ADMIN_PASSWORD=change-me-please

# Optional
# APP_LANG=pt                 # fallback language when the browser doesn't ask for pt or en
# SITE_TITLE=Prendas da família
# BASE_URL=https://gifts.example.com   # used for the share link shown in the admin
# TZ=Europe/Lisbon
# LINK_PREVIEWS=true          # fetch product images from gift links
# CURRENCY=EUR                # currency for prices typed by hand in "Gifts to give"
# REMINDER_HOUR=9             # hour (in TZ) when daily reminders are sent

# Only if you use the Cloudflare Tunnel profile (see README)
# TUNNEL_TOKEN=
