# Required: password for /admin (at least 8 characters)
ADMIN_PASSWORD=change-me-please

# Optional
# APP_LANG=pt                 # fallback language when the browser doesn't ask for pt or en
# SITE_TITLE=Prendas da família
# BASE_URL=https://gifts.example.com   # used for the share link shown in the admin
# TZ=Europe/Lisbon
# LINK_PREVIEWS=true          # fetch product images from gift links

# Notifications: configure them in the admin. These only set initial values (all optional).
# NOTIFY_NTFY_URL=https://ntfy.sh/giftly-<random>
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=
# NOTIFY_EVENTS=pick,unpick        # add ",join" to know when someone opens a list

# Only if you use the Cloudflare Tunnel profile (see README)
# TUNNEL_TOKEN=
